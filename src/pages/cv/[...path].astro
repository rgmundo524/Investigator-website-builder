---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { includeDrafts } from '../../lib/content';
import { cvEntries, cvSources } from '../../lib/cv';
import { sortExperience, isCurrentPosition } from '../../lib/experience';
import { formatMonth, formatPeriods } from '../../lib/dates';
import { groupCredentials } from '../../lib/credentials';

export async function getStaticPaths() {
  const sources = cvSources(await getCollection('pages'), await getCollection('profile'), includeDrafts);
  return sources ? [{ params: { path: undefined } }] : [];
}

const sources = cvSources(await getCollection('pages'), await getCollection('profile'), includeDrafts)!;
const { home, profile, workHistory, credentials: credentialPage, contact } = sources;
const showRoles = workHistory?.data.section_order.includes('experience');
const experience = showRoles ? sortExperience(cvEntries(await getCollection('experience'), workHistory!.data.experience,
  includeDrafts, workHistory!.data.experience_source === 'all')) : [];
const credentials = credentialPage?.data.section_order.includes('credentials')
  ? cvEntries(await getCollection('credentials'), credentialPage.data.credentials, includeDrafts, credentialPage.data.credentials_source === 'all') : [];
const education = credentialPage?.data.section_order.includes('education')
  ? cvEntries(await getCollection('education'), credentialPage.data.education, includeDrafts) : [];
const expertise = workHistory?.data.section_order.includes('expertise')
  ? cvEntries(await getCollection('expertise'), workHistory.data.expertise, includeDrafts)
  : cvEntries(await getCollection('expertise'), home.data.expertise, includeDrafts);
const projects = cvEntries(await getCollection('projects'), home.data.projects, includeDrafts);
const groups = groupCredentials(credentials, credentialPage?.data.issuer_order);
const today = new Date().toISOString().slice(0, 10);
const pdf = profile.data.cv;
---
<SiteLayout title={`Professional CV | ${profile.data.name}`} description={profile.data.description_short}
  profile={profile} socialImagePath="/open-graph/cv.png">
  <div class="container cv-actions" aria-label="CV actions">
    <a href="/">Back to home</a>
    <div class="actions">
      {pdf && <a class="button button-primary" href={pdf.url} download>{pdf.label ?? 'Download CV (PDF)'}</a>}
      <button class={pdf ? 'button cv-print' : 'button button-primary cv-print'} type="button" data-print-cv hidden>Print / save as PDF</button>
    </div>
    <p class="meta">This view uses the same profile, experience, and qualifications displayed on this site.</p>
  </div>
  <article class="container cv-document" aria-labelledby="cv-name">
    {includeDrafts && <p class="cv-draft-note">Draft preview. Review the content before sharing this CV.</p>}
    <header class="cv-heading">
      <p class="eyebrow">Professional curriculum vitae</p>
      <h1 id="cv-name">{profile.data.name}</h1>
      <p class="cv-headline">{profile.data.headline}</p>
      {profile.data.location && <p class="meta">{profile.data.location}</p>}
      <p>{profile.data.blocks.cv_summary ?? profile.data.description_short}</p>
      <p class="cv-contact"><a href={Astro.site}>{Astro.site?.host}</a>{contact && <> · <a href="/contact/">Professional contact</a></>}</p>
    </header>
    {expertise.length > 0 && <section aria-labelledby="cv-expertise"><h2 id="cv-expertise">Areas of expertise</h2>
      <ul class="cv-expertise">{expertise.map(({ data }) => <li><strong>{data.title}</strong><span>{data.description_short}</span></li>)}</ul>
    </section>}
    {experience.length > 0 && <section aria-labelledby="cv-experience"><h2 id="cv-experience">Professional experience</h2>
      {experience.map((entry) => <section class="cv-entry" aria-labelledby={`cv-role-${entry.id}`}>
        <div class="cv-entry-heading"><h3 id={`cv-role-${entry.id}`}>{entry.data.role}</h3><p class="meta">{formatPeriods(entry.data.periods)}{isCurrentPosition(entry) ? `${entry.data.periods.length ? ' · ' : ''}Current role` : ''}</p></div>
        <p class="cv-organization">{entry.data.organization}{entry.data.location && ` · ${entry.data.location}`}</p>
        <p>{entry.data.description_short}</p>
        {entry.data.highlights.length > 0 && <ul>{entry.data.highlights.map(({ text }) => <li>{text}</li>)}</ul>}
      </section>)}
    </section>}
    {education.length > 0 && <section aria-labelledby="cv-education"><h2 id="cv-education">Education</h2>
      {education.map(({ id, data }) => <section class="cv-entry" aria-labelledby={`cv-education-${id}`}>
        <h3 id={`cv-education-${id}`}>{data.program}</h3><p class="cv-organization">{data.institution}</p>
        <p class="meta">{formatMonth(data.start)} to {data.end ? formatMonth(data.end) : 'Present'}{data.credential_type === 'attendance' ? ' · Attendance' : data.completion_status === 'completed' ? ' · Completed' : data.completion_status === 'in_progress' ? ' · In progress' : ' · Studies'}</p>
      </section>)}
    </section>}
    {groups.length > 0 && <section aria-labelledby="cv-credentials"><h2 id="cv-credentials">Certifications and training</h2>
      {groups.map((group) => <section class="cv-entry" aria-labelledby={`cv-${group.id}`}>
        <h3 id={`cv-${group.id}`}>{group.issuer}</h3><ul>{group.entries.map(({ data }) => <li>
          <strong>{data.name}</strong> · {data.issued_year} · {data.credential_type}
          {data.expires_on && <span> · {data.expires_on < today ? 'Expired' : 'Expires'} {data.expires_on}</span>}
          {data.verification_url && <> · <a href={data.verification_url}>Verify credential</a></>}
        </li>)}</ul>
      </section>)}
    </section>}
    {projects.length > 0 && <section aria-labelledby="cv-projects"><h2 id="cv-projects">Selected work</h2>
      {projects.map(({ id, data }) => <section class="cv-entry" aria-labelledby={`cv-project-${id}`}>
        <h3 id={`cv-project-${id}`}>{data.title}</h3><p class="meta">{data.contribution}</p><p>{data.description_short}</p>
        {data.links.length > 0 && <ul>{data.links.map((link) => <li><a href={link.url}>{link.label}</a></li>)}</ul>}
      </section>)}
    </section>}
  </article>
</SiteLayout>

<script>
  const printButton = document.querySelector<HTMLButtonElement>('[data-print-cv]');
  if (printButton) {
    printButton.hidden = false;
    printButton.addEventListener('click', () => window.print());
  }
</script>

<style>
  .cv-actions { padding-block: 2rem 1rem; }
  .cv-actions > .actions { margin-block: 1.2rem; }
  .cv-actions .cv-print:not(.button-primary) { background: var(--surface); color: var(--ink); border-color: var(--line); cursor: pointer; }
  .cv-draft-note { font-weight: 600; color: var(--accent-text); }
  .cv-document { max-width: 65rem; padding-block: 2rem 4rem; background: var(--paper); }
  .cv-heading { border-bottom: 2px solid var(--accent); padding-bottom: 1.5rem; margin-bottom: 2rem; }
  .cv-heading h1 { font-size: clamp(2.3rem, 5vw, 3.8rem); margin-bottom: .8rem; }
  .cv-headline { font-size: 1.15rem; font-weight: 600; }
  .cv-document h2 { font-family: inherit; font-size: 1.5rem; letter-spacing: normal; padding-bottom: .6rem; border-bottom: 1px solid var(--line); }
  .cv-document > section { margin-block: 2rem; }
  .cv-entry { margin-block: 1.4rem; }
  .cv-entry h3 { margin-bottom: .25rem; }
  .cv-entry p { margin-bottom: .6rem; }
  .cv-entry-heading { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .3rem 1rem; }
  .cv-organization { font-weight: 600; }
  .cv-expertise { padding-left: 1.2rem; }
  .cv-expertise li { margin-bottom: .7rem; }
  .cv-expertise span { display: block; }
  .cv-document :global(a) { overflow-wrap: anywhere; }
  @media print {
    @page { margin: 16mm; }
    :global(html), :global(body) { background: white !important; color: #111 !important; }
    :global(.site-header), :global(.site-footer), :global(.site-particles), :global(.particle-toggle), :global(.skip-link), .cv-actions { display: none !important; }
    .cv-document { width: 100%; max-width: none; margin: 0; padding: 0; color: #111; background: white; font-size: 10pt; line-height: 1.45; }
    .cv-heading { border-color: #333; margin-bottom: 1.3rem; }
    .cv-heading h1 { font-size: 26pt; }
    .cv-document h2 { font-size: 14pt; border-color: #aaa; break-after: avoid; }
    .cv-document h3 { font-size: 11pt; break-after: avoid; }
    .cv-document > section { margin-block: 1.2rem; }
    .cv-entry { margin-block: 1rem; }
    .cv-entry-heading, .cv-organization { break-after: avoid; }
    .cv-document :global(p), .cv-document :global(li) { orphans: 3; widows: 3; }
    .cv-document :global(a), .cv-document :global(.meta), .cv-document :global(.eyebrow) { color: #333 !important; }
    .cv-draft-note { color: #333; border: 1px solid #999; padding: .5rem; }
    .cv-contact a { text-decoration: none; }
  }
</style>
