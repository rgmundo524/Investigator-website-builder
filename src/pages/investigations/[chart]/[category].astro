---
import { getCollection, getEntry } from 'astro:content';
import type { InferGetStaticPropsType } from 'astro';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { Icon } from 'astro-icon/components';
import { caseRoutes, caseSubcategories, caseUrl, selectedCaseCharts, statusLabels, subcategoryAnchor } from '../../../lib/cases';
import { includeDrafts, isVisible } from '../../../lib/content';
import { categoryUrl, formatShare, summarizeCases } from '../../../lib/charts';

export async function getStaticPaths() {
  const [charts, studies, page] = await Promise.all([getCollection('charts'), getCollection('cases'), getEntry('pages', 'casework')]);
  return caseRoutes(selectedCaseCharts(page, charts, includeDrafts), studies, includeDrafts).map(({ chart, category, datasets }) => ({
    params: { chart: chart.id, category: category.id }, props: { chart, category, datasets },
  }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { chart, category, datasets }: Props = Astro.props;
const casework = await getEntry('pages', 'casework');
const back = casework && isVisible(casework) ? { url: '/casework/#section-casework', label: 'Back to case charts' } : { url: '/', label: 'Back to home' };
---
<SiteLayout title={`${category.label} | ${chart.data.title}`} description={`Explore ${category.label.toLowerCase()} case records in ${chart.data.title.toLowerCase()}.`}>
  <header class="container page-intro">
    <p class="back-link"><a href={back.url}>← {back.label}</a></p>
    <p class="eyebrow">{chart.data.title}</p><h1>{category.label}</h1>
  </header>
  <nav class="container category-nav" aria-label={`Categories in ${chart.data.title}`}>
    {chart.data.categories.map((item) => <a href={categoryUrl(chart.id, item.id)} aria-current={item.id === category.id ? 'page' : undefined}>{item.label}</a>)}
  </nav>
  {datasets.map(({ kind, category: count, categories, studies }) => {
    const { slices, total } = summarizeCases(categories);
    const share = slices.find(({ id }) => id === category.id)?.percentage ?? null;
    return <section class="container content-section case-record-group" id={`dataset-${kind}`} aria-labelledby={`heading-${kind}`}>
      <h2 id={`heading-${kind}`}>{kind === 'example' ? 'Example cases' : 'Recorded cases'}</h2>
      <p class="page-lead">{count.count} {kind === 'example' ? 'example' : 'recorded'} {count.count === 1 ? 'case' : 'cases'}{share !== null ? ` · ${formatShare(share)} of ${total} in this dataset` : ''}</p>
      {kind === 'example' && <p class="notice">Illustrative examples, not actual engagements. These records are excluded from actual case statistics.</p>}
      {studies.length === 0 && <p>No {kind === 'example' ? 'examples' : 'case records'} have been added to this category yet.</p>}
      {caseSubcategories(studies).map((subcategory) => <section class="case-subcategory" id={subcategoryAnchor(kind, subcategory.id)} aria-labelledby={`${subcategoryAnchor(kind, subcategory.id)}-title`}>
        <h3 class="case-subcategory-heading" id={`${subcategoryAnchor(kind, subcategory.id)}-title`}>{subcategory.label} · {subcategory.count} {subcategory.count === 1 ? 'case' : 'cases'}</h3>
        {subcategory.studies.map((entry) => <article class="case-study case-summary" id={entry.id} aria-labelledby={`${entry.id}-title`}>
          <h4 id={`${entry.id}-title`}><a href={caseUrl(entry.id)}>{entry.data.title}</a></h4>
          <p class="lead">{entry.data.description_short}</p>
          <p class="meta">{[entry.data.role, statusLabels[entry.data.case_status]].filter(Boolean).join(' · ')}</p>
          <a class="text-link" href={caseUrl(entry.id)}>Read case details <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a>
        </article>)}
      </section>)}
    </section>;
  })}
  <p class="container back-link"><a href={back.url}>{back.label}</a></p>
</SiteLayout>
