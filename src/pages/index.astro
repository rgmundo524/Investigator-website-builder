---
import { getCollection, getEntry, render } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import Portrait from '../components/Portrait.astro';
import PersonalPhotos from '../components/PersonalPhotos.astro';
import { Icon } from 'astro-icon/components';
import { includeDrafts, isVisible, pageProfile, selected } from '../lib/content';
import { publicLocation } from '../lib/public-profile';
import { sectionDestination } from '../lib/section-placement';

const home = await getEntry('pages', 'home');
const page = home && isVisible(home) ? home : undefined;
const profile = await pageProfile(page);
const hasPortrait = page?.data.portrait?.enabled !== false && Boolean(page?.data.portrait?.images.length);
const location = profile ? publicLocation(profile.data) : undefined;
const intro = page ? await render(page) : undefined;
const Intro = intro?.Content;
const expertise = page ? await selected('expertise', page.data.expertise) : [];
const experience = page ? await selected('experience', page.data.experience) : [];
const projects = page ? await selected('projects', page.data.projects) : [];
const visiblePages = await getCollection('pages', isVisible);
const hasPage = (id: string) => visiblePages.some((entry) => entry.id === id);
const expertiseDestination = expertise.length
  ? sectionDestination(visiblePages, 'expertise', await getCollection('expertise', isVisible), { includeDrafts }) : undefined;
const featuredProjects = projects.map((entry) => ({ entry,
  destination: sectionDestination(visiblePages, 'projects', projects, { includeDrafts, recordId: entry.id }),
}));
---
<SiteLayout title={page?.data.title ?? 'Site in preparation'} description={page?.data.description_short ?? 'A personal website in preparation.'} profile={profile}>
  {page && profile ? <>
    <section class:list={['container', 'hero', { 'hero-with-portrait': hasPortrait }]}>
      <div class="hero-copy">
        <p class="eyebrow">{profile.data.headline}</p>
        <h1>{profile.data.name}</h1>
        {location && <p class="meta">{location}</p>}
        <p class="hero-statement">{page.data.blocks.hero_statement}</p>
        {Intro && <div class="hero-intro"><Intro /></div>}
        <div class="actions">
          {hasPage('casework') && <a class="button button-primary" href="/casework/">Explore my work <Icon name="lucide:arrow-up-right" aria-hidden="true" /></a>}
          {hasPage('work-history') && <a class="text-link" href="/work-history/">Work history <Icon name="lucide:arrow-right" aria-hidden="true" /></a>}
        </div>
      </div>
      <Portrait portrait={page.data.portrait} name={profile.data.name} />
    </section>
    {experience.length > 0 && <div class="container experience-strip">
      <span class="eyebrow">{page.data.blocks.experience_label}</span>
      <ul>{experience.map(({ data }) => <li>{data.blocks.organization_short ?? data.organization}</li>)}</ul>
    </div>}
    {expertise.length > 0 && <section class="container home-section">
      <div class="section-heading"><div><p class="eyebrow">Areas of focus</p><h2>{page.data.blocks.expertise_heading}</h2></div>
        {expertiseDestination && <a class="text-link" href={expertiseDestination}>All areas of expertise <Icon name="lucide:arrow-right" aria-hidden="true" /></a>}
      </div>
      <div class="expertise-grid">{expertise.map((entry, index) => <article class="expertise-preview">
        <span class="section-number">{String(index + 1).padStart(2, '0')}</span>
        <h3>{entry.data.title}</h3>
        <p>{entry.data.description_short}</p>
      </article>)}</div>
    </section>}
    {projects.length > 0 && <section class="featured-work"><div class="container featured-inner">
      <div><p class="eyebrow">Selected work</p><h2>{page.data.blocks.project_heading}</h2></div>
      <div class="featured-projects">{featuredProjects.map(({ entry, destination }) => <article>
        <p class="project-role">{entry.data.contribution}</p>
        <h3>{entry.data.title}</h3><p>{entry.data.description_short}</p>
        {destination && <a class="text-link" href={destination}>Read about this work <Icon name="lucide:arrow-right" aria-hidden="true" /></a>}
      </article>)}</div>
    </div></section>}
    <PersonalPhotos page={page} />
    {hasPage('contact') && <section class="container contact-band">
      <div><p class="eyebrow">Professional enquiries</p><h2>{page.data.blocks.contact_heading}</h2><p>{page.data.blocks.contact_description}</p></div>
      <a class="button button-primary" href="/contact/">Contact me <Icon name="lucide:arrow-right" aria-hidden="true" /></a>
    </section>}
  </> : <section class="container page-intro"><h1>Site in preparation</h1><p>Content will appear here when it is ready for publication.</p></section>}
</SiteLayout>
