---
import { render, type CollectionEntry } from 'astro:content';
import { caseTitle, readable, subcategoryPath } from '../lib/cases';
import { Icon } from 'astro-icon/components';
import { formatDate } from '../lib/dates';
import { siteSettings } from '../lib/site-settings';
import { offChainLeadLabels } from '../lib/off-chain-leads';
type Props = { entry: CollectionEntry<'cases'>; heading?: 'h3' | 'h4' };
const { entry, heading: Heading = 'h3' } = Astro.props;
const Subheading = Heading === 'h3' ? 'h4' : 'h5';
const { Content } = await render(entry);
const hasUsdAmounts = entry.data.metrics.reported_loss_usd !== null || entry.data.metrics.assets_reviewed_usd !== null;
---
<article class="case-study" id={entry.id} aria-labelledby={`${entry.id}-title`}>
        {entry.data.content_kind === 'example' && <p class="example-label">Illustrative case example</p>}
        <Heading id={`${entry.id}-title`}>{caseTitle(entry.data)}</Heading>
        {entry.data.case_number && <p class="meta">{entry.data.title}</p>}
        <p class="lead">{entry.data.description_short}</p>
        <dl class="case-facts">
          <div><dt>Classification</dt><dd>{subcategoryPath(entry).map(readable).join(' → ')}</dd></div>
          {entry.data.opened_on && <div><dt>Engaged</dt><dd>{formatDate(entry.data.opened_on, siteSettings.locale)}</dd></div>}
          {entry.data.closed_on && <div><dt>Report issued</dt><dd>{formatDate(entry.data.closed_on, siteSettings.locale)}</dd></div>}
          {entry.data.role && <div><dt>Role</dt><dd>{entry.data.role}</dd></div>}
          {entry.data.networks.length > 0 && <div><dt>Networks</dt><dd>{entry.data.networks.map(readable).join(', ')}</dd></div>}
          {entry.data.assets.length > 0 && <div><dt>Assets</dt><dd>{entry.data.assets.join(', ')}</dd></div>}
          {entry.data.jurisdictions.length > 0 && <div><dt>Jurisdictions</dt><dd>{entry.data.jurisdictions.join(', ')}</dd></div>}
          {entry.data.services.length > 0 && <div><dt>Services</dt><dd>{entry.data.services.map(readable).join(', ')}</dd></div>}
          {entry.data.off_chain_leads.length > 0 && <div><dt>Off-chain leads</dt><dd>{offChainLeadLabels(entry.data.off_chain_leads).join(', ')}</dd></div>}
          {[{ label: 'Reported loss', value: entry.data.metrics.reported_loss_usd }, { label: 'Assets reviewed', value: entry.data.metrics.assets_reviewed_usd }].map(({ label, value }) => value !== null && <div><dt>{label}</dt><dd>{new Intl.NumberFormat(siteSettings.locale, { style: 'currency', currency: 'USD' }).format(value)}</dd></div>)}
        </dl>
        {entry.data.scope_summary && <section><Subheading>Scope of work</Subheading><p>{entry.data.scope_summary}</p></section>}
        {(hasUsdAmounts || entry.data.metrics.amount_note) && <p class="meta">{hasUsdAmounts && 'USD values use transaction-time prices unless noted otherwise.'}{entry.data.metrics.amount_note && `${hasUsdAmounts ? ' ' : ''}${entry.data.metrics.amount_note}`}</p>}
        {entry.data.blocks.investigative_question && <p class="callout">{entry.data.blocks.investigative_question}</p>}
        <div class="prose"><Content /></div>
        {entry.data.links.length > 0 && <ul>{entry.data.links.map((link) => <li><a class="external-reference" href={link.url}>{link.label}<Icon name="lucide:external-link" aria-hidden="true" /></a></li>)}</ul>}
      </article>
