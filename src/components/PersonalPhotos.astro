---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { assertSupportedPhoto } from '../lib/image-privacy';

type Props = { page: CollectionEntry<'pages'> };
const { page } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('@site-assets/images/personal/*.{png,jpg,jpeg,webp}');
const photos = await Promise.all(page.data.personal_photos.map(async (photo) => {
  const loader = Object.entries(files).find(([file]) => file.endsWith(`/${photo.image}`))?.[1];
  if (!loader) throw new Error(`Missing personal photo asset: assets/images/personal/${photo.image}`);
  const source = (await loader()).default;
  await assertSupportedPhoto(source);
  return { ...photo, source };
}));
---
{photos.length > 0 && <section class="container content-section personal-photos" id="section-personal-photos" aria-labelledby="heading-personal-photos">
  <div class="section-heading">
    <div>
      <h2 id="heading-personal-photos">{page.data.blocks.personal_photos_heading ?? 'Photos'}</h2>
      {page.data.blocks.personal_photos_intro && <p class="reading-copy">{page.data.blocks.personal_photos_intro}</p>}
    </div>
  </div>
  <div class="personal-photo-grid">
    {photos.map((photo) => <figure class="personal-photo">
      <div class="personal-photo-frame">
        <Image src={photo.source} alt={photo.alt} loading="lazy" decoding="async" />
      </div>
      <figcaption>{photo.caption}</figcaption>
    </figure>)}
  </div>
</section>}

<style>
  .personal-photo-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(1.25rem, 3vw, 2rem); }
  .personal-photo { min-width: 0; margin: 0; }
  .personal-photo-frame { overflow: hidden; aspect-ratio: 3 / 2; border: 1px solid var(--line); border-radius: .65rem; background: var(--surface); }
  .personal-photo img { width: 100%; height: 100%; object-fit: cover; }
  .personal-photo figcaption { max-width: 42rem; margin-top: .85rem; padding-inline: .1rem; color: var(--muted); font-size: .875rem; line-height: 1.6; }
  @media (max-width: 640px) { .personal-photo-grid { grid-template-columns: 1fr; } }
</style>
