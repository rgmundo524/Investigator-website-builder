<canvas id="site-particles" class="site-particles" aria-hidden="true" hidden></canvas>
<script>
  import type { Container } from '@tsparticles/engine';
  import { particleOptions } from '../lib/particles';

  const canvas = document.querySelector<HTMLCanvasElement>('#site-particles');
  if (canvas) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const compact = matchMedia('(max-width: 760px)');
    const hover = matchMedia('(hover: hover)');
    let container: Container | undefined;
    let generation = 0;
    let disposed = false;
    let queued = Promise.resolve();
    let engine: Promise<typeof import('@tsparticles/engine')['tsParticles']> | undefined;
    function loadEngine() {
      return engine ??= Promise.all([import('@tsparticles/engine'), import('@tsparticles/slim')])
        .then(async ([{ tsParticles }, { loadSlim }]) => { await loadSlim(tsParticles); return tsParticles; })
        .catch((error) => { engine = undefined; throw error; });
    }

    function refresh() {
      const request = ++generation;
      container?.destroy();
      container = undefined;
      canvas!.hidden = true;
      queued = queued.then(async () => {
        if (disposed || request !== generation || reduced.matches) return;
        const tsParticles = await loadEngine();
        if (disposed || request !== generation || reduced.matches) return;
        canvas!.hidden = false;
        const next = await tsParticles.load({ element: canvas!, options: particleOptions(document.documentElement.dataset.theme === 'dark', compact.matches, hover.matches) });
        if (disposed || request !== generation || reduced.matches) { next?.destroy(); return; }
        container = next;
      }).catch((error) => {
        if (request !== generation || disposed) return;
        canvas!.hidden = true;
        console.warn('The decorative background could not be loaded.', error);
      });
    }

    function clearHoverOnScroll() {
      // tsParticles updates canvas-relative hover coordinates on pointer movement.
      // Hide the old connection while scrolling until its next pointer update.
      type HoverPlugin = Container['plugins'][number] & {
        interactionManager: { interactivityData: { mouse: { position?: unknown } } };
      };
      const plugin = container?.plugins.find((entry): entry is HoverPlugin => 'interactionManager' in entry);
      if (plugin) delete plugin.interactionManager.interactivityData.mouse.position;
    }
    const theme = new MutationObserver(refresh);
    theme.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    reduced.addEventListener('change', refresh);
    compact.addEventListener('change', refresh);
    hover.addEventListener('change', refresh);
    function onPageHide() {
      disposed = true;
      generation++;
      container?.destroy();
      container = undefined;
    }
    function onPageShow(event: PageTransitionEvent) {
      if (event.persisted) { disposed = false; refresh(); }
    }
    window.addEventListener('pagehide', onPageHide);
    window.addEventListener('pageshow', onPageShow);
    window.addEventListener('scroll', clearHoverOnScroll, { passive: true });
    import.meta.hot?.dispose(() => {
      disposed = true;
      generation++;
      container?.destroy();
      theme.disconnect();
      reduced.removeEventListener('change', refresh);
      compact.removeEventListener('change', refresh);
      hover.removeEventListener('change', refresh);
      window.removeEventListener('pagehide', onPageHide);
      window.removeEventListener('pageshow', onPageShow);
      window.removeEventListener('scroll', clearHoverOnScroll);
    });
    refresh();
  }
</script>
