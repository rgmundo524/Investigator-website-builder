---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import type { ContentData } from '../content/schemas';
import { assertSupportedPhoto } from '../lib/image-privacy';
import portraitRestore from '../scripts/portrait-restore.js?raw';
type Props = { portrait?: ContentData<'pages'>['portrait']; name?: string; compact?: boolean };
const { portrait, name, compact = false } = Astro.props;
const photos = portrait?.enabled === false ? [] : portrait?.images ?? [];
const files = import.meta.glob<{ default: ImageMetadata }>('@site-assets/*.{png,jpg,jpeg,webp}');
const images = await Promise.all(photos.map(async (photo) => {
  const loader = Object.entries(files).find(([file]) => file.endsWith(`/${photo.image}`))?.[1];
  if (!loader) throw new Error(`Missing portrait asset: assets/${photo.image}`);
  const source = (await loader()).default;
  await assertSupportedPhoto(source);
  return { ...photo, source };
}));
const multiple = images.length > 1;
const continuityScope = JSON.stringify([Astro.site?.href ?? '', name ?? '']);
---
{images.length > 0 && <figure class:list={['portrait', { 'page-portrait': compact }]} data-portrait-rotation={multiple ? '' : undefined} data-portrait-scope={multiple ? continuityScope : undefined} data-autoplay={multiple ? String(portrait?.autoplay ?? true) : undefined} data-interval={multiple ? (portrait?.interval_ms ?? 6000) : undefined} aria-roledescription={multiple ? 'slideshow' : undefined} aria-label={multiple ? (name ? `Photos of ${name}` : 'Page photos') : undefined}>
  <div class="portrait-mat">
    <div class="portrait-viewport">
      <div class="portrait-slides">
        {images.map((photo, index) => <div class="portrait-slide" data-portrait-slide data-portrait-photo={photo.image} hidden={index > 0} aria-hidden={index > 0 ? 'true' : 'false'}>
          <Image src={photo.source} alt={photo.alt} width={compact ? 448 : undefined} widths={compact ? [224, 448] : undefined} sizes={compact ? '(max-width: 640px) 192px, 224px' : undefined} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" draggable="false" />
        </div>)}
      </div>
    </div>
  </div>
  {portrait?.caption && <figcaption>{portrait.caption}</figcaption>}
</figure>}
{multiple && <script is:inline set:html={portraitRestore}></script>}

<script>
  import { initPortraitRotation, destroyPortraitRotation } from '../lib/portrait-carousel';
  initPortraitRotation();
  document.addEventListener('astro:page-load', initPortraitRotation);
  document.addEventListener('astro:before-swap', destroyPortraitRotation);
  window.addEventListener('pagehide', destroyPortraitRotation);
  window.addEventListener('pageshow', initPortraitRotation);
  import.meta.hot?.dispose(() => {
    destroyPortraitRotation();
    document.removeEventListener('astro:page-load', initPortraitRotation);
    document.removeEventListener('astro:before-swap', destroyPortraitRotation);
    window.removeEventListener('pagehide', destroyPortraitRotation);
    window.removeEventListener('pageshow', initPortraitRotation);
  });
</script>
