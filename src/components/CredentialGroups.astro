---
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import ContentEntry from './ContentEntry.astro';
import { credentialIssuerKey, groupCredentials } from '../lib/credentials';
import { assertSupportedPhoto } from '../lib/image-privacy';
type Props = {
  entries: CollectionEntry<'credentials'>[];
  issuerOrder?: string[];
  issuerLogos?: CollectionEntry<'pages'>['data']['issuer_logos'];
  preserveEntryOrder?: boolean;
};
const logos = new Map((Astro.props.issuerLogos ?? []).map((logo) => [credentialIssuerKey(logo.issuer), logo]));
const files = import.meta.glob<{ default: ImageMetadata }>('@site-assets/organizations/*.{png,jpg,jpeg,webp}');
const groups = await Promise.all(groupCredentials(Astro.props.entries, Astro.props.issuerOrder, Astro.props.preserveEntryOrder).map(async (group) => {
  const logo = logos.get(credentialIssuerKey(group.issuer));
  if (!logo) return { ...group, logo: undefined };
  const loader = Object.entries(files).find(([file]) => file.endsWith(`/${logo.image}`))?.[1];
  if (!loader) throw new Error(`Missing credential issuer logo: assets/organizations/${logo.image}`);
  const source = (await loader()).default;
  await assertSupportedPhoto(source);
  return { ...group, logo: { ...logo, source } };
}));
---
<nav class="credential-issuer-nav" aria-label="Credential issuers">
  {groups.map((group) => <a href={`#${group.id}`}>{group.issuer}<span>{group.entries.length}</span></a>)}
</nav>
<div class="credential-groups">
  {groups.map((group) => <section class="credential-group" aria-labelledby={group.id}>
    <header class:list={['credential-group-heading', { 'has-issuer-logo': Boolean(group.logo) }]}>
      {group.logo && <span class="credential-issuer-logo"><Image src={group.logo.source} alt={group.logo.alt} loading="lazy" decoding="async" /></span>}
      <h3 id={group.id}>{group.issuer}</h3>
      <span>{group.entries.length} {group.entries.length === 1 ? 'credential' : 'credentials'}</span>
    </header>
    <div class="entry-list collection-credentials">{group.entries.map((entry) => <ContentEntry entry={entry} grouped />)}</div>
  </section>)}
</div>

<style>
  .credential-group-heading.has-issuer-logo { align-items: center; }
  .credential-group-heading.has-issuer-logo h3 { flex: 1 1 12rem; }
  .credential-issuer-logo { flex: 0 0 auto; display: flex; align-items: center; justify-content: center; width: 7.5rem; height: 4.75rem; padding: .6rem; border: 1px solid #dedbd3; border-radius: .5rem; background: #f8f6f1; }
  .credential-issuer-logo img { display: block; width: 100%; height: 100%; object-fit: contain; }
  @media (max-width: 640px) {
    .credential-issuer-logo { width: 5.75rem; height: 4rem; padding: .45rem; }
    .credential-group-heading.has-issuer-logo h3 { flex-basis: 10rem; }
  }
</style>
