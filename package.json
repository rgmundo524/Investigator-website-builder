{
  "name": "investigator-website-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "postinstall": "node scripts/ensure-dependencies.mjs --record",
    "predev": "node scripts/ensure-dependencies.mjs",
    "dev": "astro dev",
    "precheck:content": "node scripts/ensure-dependencies.mjs",
    "check:content": "node --import tsx scripts/check-content.ts",
    "check": "npm run check:content && astro check",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "prepreview": "node scripts/ensure-dependencies.mjs",
    "build:drafts": "node --import tsx scripts/build-drafts.ts",
    "preview:drafts": "astro preview --outDir dist-drafts",
    "prepreview:drafts": "node scripts/ensure-dependencies.mjs",
    "prebuild:drafts": "node scripts/ensure-dependencies.mjs",
    "pretest": "node scripts/ensure-dependencies.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "precontent:export": "node scripts/ensure-dependencies.mjs",
    "content:export": "node --import tsx scripts/export-content.ts",
    "presite:init": "node scripts/ensure-dependencies.mjs",
    "site:init": "node --import tsx scripts/init-site.ts",
    "presite:package": "node scripts/ensure-dependencies.mjs",
    "site:package": "node --import tsx scripts/package-site.ts",
    "presite:template": "node scripts/ensure-dependencies.mjs",
    "site:template": "node --import tsx scripts/template-site.ts",
    "preeditor": "node scripts/ensure-dependencies.mjs",
    "editor": "node --import tsx scripts/editor-server.ts",
    "start": "node scripts/start-builder.mjs",
    "builder:package": "node scripts/package-builder.mjs"
  },
  "dependencies": {
    "@amcharts/amcharts5": "5.20.5",
    "@astrojs/markdown-satteri": "0.4.0",
    "@astrojs/mdx": "8.0.0",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/inter": "5.3.0",
    "@iconify-json/lucide": "1.2.129",
    "@mdx-js/mdx": "3.1.1",
    "@tsparticles/engine": "4.4.0",
    "@tsparticles/slim": "4.4.0",
    "astro": "7.3.1",
    "astro-icon": "1.2.0",
    "astro-og-canvas": "0.13.1",
    "embla-carousel": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "pagefind": "1.5.2",
    "satteri": "0.10.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rgmundo524/Investigator-website-builder.git"
  }
}
